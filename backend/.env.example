# Copy to .env or export in your shell. Never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/eyota_hr
DB_USER=postgres
DB_PASSWORD=postgres2204

SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200

# Must be a long random string (32+ characters)
JWT_SECRET=replace_with_a_long_random_secret_key_here
JWT_EXPIRATION_MINUTES=60

# Optional one-time bootstrap (leave empty in production after first admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.sg
BOOTSTRAP_ADMIN_PASSWORD=use_a_strong_unique_password

GPS_MAX_ACCURACY_METRES=50
